# Copy to .env and fill locally. Never commit .env.

# Zendesk
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=your-email
ZENDESK_API_TOKEN=replace-with-zendesk-token
ZENDESK_PRODUCT_FIELD_ID=replace-with-product-field-id
ZENDESK_INCLUDE_TAG=replace-with-qualifying-tag
ZENDESK_EXCLUDE_TAG=replace-with-excluded-tag

# Human lead-response author matching. Use a local name or ID pattern.
LEAD_RESPONSE_AUTHOR_PATTERN=replace-with-author-pattern

# Jira read-only access
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-jira-email
JIRA_API_TOKEN=replace-with-jira-token
JIRA_ISSUE_FIELD_ID=replace-with-jira-field-id

# Local Codex executable
CODEX_CLI_PATH=/path/to/codex

# Optional Apps Script bridge
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_SHARED_SECRET=
